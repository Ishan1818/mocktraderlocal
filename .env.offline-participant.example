# TRADEVERSE offline participant — copy to .env
LOCAL_INSTANCE_MODE=true
ENVIRONMENT=development
DEBUG=true
AUTO_INIT_DB=true

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765
BACKEND_URL=http://127.0.0.1:8765
FRONTEND_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8765

DEFAULT_STARTING_CAPITAL=500000
MAX_POSITION_PER_STOCK=100
SIMULATION_SPEED=1
RANDOM_SEED=42

# --- Leaderboard sync (pick ONE) ---

# Recommended: Supabase (no LAN IP, works on any Wi‑Fi / even home internet)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_LEADERBOARD_TABLE=participant_snapshots
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_LEADERBOARD_TABLE=participant_snapshots

# Alternative: organizer laptop on same Wi‑Fi (leave Supabase blank if using this)
# LEADERBOARD_SYNC_URL=http://192.168.1.10:9000/api/v1/snapshot
# NEXT_PUBLIC_LEADERBOARD_URL=http://192.168.1.10:9000

LEADERBOARD_SYNC_INTERVAL_SEC=45

HIDE_ADMIN_UI=true
SERVE_STATIC_UI=false
NEXT_PUBLIC_LOCAL_INSTANCE=true

NEXT_PUBLIC_API_URL=http://127.0.0.1:8765
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8765
NEXT_PUBLIC_API_PREFIX=/api/v1

# Organizer announces at event start (not included in participant zip)
# TIMELINE_DECRYPT_KEY=
